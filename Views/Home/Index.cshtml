@{
    ViewData["Title"] = "Home";
}

<!-- ================= HERO SECTION ================= -->

<section class="hero-section">

    ```
    <div class="container">

        <div class="row align-items-center min-vh-100">

            <div class="col-lg-9">

                <span class="hero-label fs-3 fw-semibold">
                    HUMANITARIAN RELIEF
                </span>

                <h1 class="hero-title display-1 fw-bold mt-3">
                    Restoring Hope.<br />
                    Rebuilding Lives.
                </h1>

                <p class="hero-text fs-2 mt-4">
                    Together, we can provide emergency assistance,
                    medical support, food, water and hope to communities
                    affected by disaster and hardship.
                </p>

                <div class="hero-buttons d-flex flex-wrap gap-4 mt-5">

                    <a asp-controller="Donation"
                       asp-action="Index"
                       class="btn btn-danger btn-lg px-5 py-4 fs-4">
                        Donate Now
                    </a>

                    <a asp-controller="Projects"
                       asp-action="Index"
                       class="btn btn-outline-light btn-lg px-5 py-4 fs-4">
                        Our Projects
                    </a>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-light btn-lg px-5 py-4 fs-4">
                        Login
                    </a>

                </div>

            </div>

        </div>

    </div>
    ```

</section>

<!-- ================= IMPACT SECTION ================= -->

<section class="impact-section py-5">

    ```
    <div class="container py-5">

        <div class="text-center mb-5 pb-4">

            <span class="section-label fs-3 fw-semibold">
                OUR IMPACT
            </span>

            <h2 class="display-3 fw-bold mt-3">
                Making a Difference
            </h2>

            <p class="text-muted fs-3 mt-3">
                Every contribution helps us reach people who need assistance.
            </p>

        </div>


        <div class="row text-center g-5">

            <div class="col-md-4">

                <div class="impact-card h-100 p-5">

                    <div class="impact-number display-1 fw-bold">
                        25+
                    </div>

                    <h5 class="display-6 fw-bold mt-4">
                        Relief Projects
                    </h5>

                    <p class="fs-4 mt-3">
                        Humanitarian projects supporting communities in need.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="impact-card h-100 p-5">

                    <div class="impact-number display-1 fw-bold">
                        100+
                    </div>

                    <h5 class="display-6 fw-bold mt-4">
                        Volunteers
                    </h5>

                    <p class="fs-4 mt-3">
                        Dedicated people contributing their time and skills.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="impact-card h-100 p-5">

                    <div class="impact-number display-1 fw-bold">
                        10K+
                    </div>

                    <h5 class="display-6 fw-bold mt-4">
                        People Assisted
                    </h5>

                    <p class="fs-4 mt-3">
                        Families and individuals reached through our projects.
                    </p>

                </div>

            </div>

        </div>

    </div>
    ```

</section>

<!-- ================= WHAT WE DO ================= -->

<section class="services-section py-5">

    ```
    <div class="container py-5">

        <div class="text-center mb-5 pb-4">

            <span class="section-label fs-3 fw-semibold">
                WHAT WE DO
            </span>

            <h2 class="display-3 fw-bold mt-3">
                Helping Where It Matters Most
            </h2>

        </div>


        <div class="row g-5">

            <div class="col-md-4">

                <div class="service-card h-100 p-5">

                    <div class="service-icon display-1 mb-4">
                        🏥
                    </div>

                    <h4 class="display-6 fw-bold">
                        Medical Aid
                    </h4>

                    <p class="fs-4 mt-3">
                        Providing medical assistance and essential healthcare
                        support to affected communities.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="service-card h-100 p-5">

                    <div class="service-icon display-1 mb-4">
                        🍲
                    </div>

                    <h4 class="display-6 fw-bold">
                        Food Relief
                    </h4>

                    <p class="fs-4 mt-3">
                        Delivering food and essential supplies to families
                        experiencing hardship.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="service-card h-100 p-5">

                    <div class="service-icon display-1 mb-4">
                        💧
                    </div>

                    <h4 class="display-6 fw-bold">
                        Water & Sanitation
                    </h4>

                    <p class="fs-4 mt-3">
                        Supporting access to clean water and essential
                        sanitation services.
                    </p>

                </div>

            </div>

        </div>

    </div>
    ```

</section>

<!-- ================= CALL TO ACTION ================= -->

<section class="donate-section py-5">

    ```
    <div class="container py-5 text-center">

        <h2 class="display-2 fw-bold">
            Be Part of the Difference
        </h2>

        <p class="fs-2 mt-4">
            Your support can help provide urgent assistance to people
            affected by disasters and humanitarian crises.
        </p>

        <a asp-controller="Donation"
           asp-action="Index"
           class="btn btn-danger btn-lg px-5 py-4 fs-3 mt-4">
            Make a Donation
        </a>

    </div>
    ```

</section>
