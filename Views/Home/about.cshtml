@{
    ViewData["Title"] = "About Us";
}

<!-- About Hero -->

<section class="about-hero">
    <div class="container text-center">

        ```
        <span class="section-label">ABOUT US</span>

        <h1>Serving Humanity With Compassion</h1>

        <p>
            Our mission is to bring hope, assistance and practical support
            to communities affected by disaster, poverty and hardship.
        </p>

    </div>
    ```

</section>

<!-- Who We Are -->

<section class="about-section">
    <div class="container">

        ```
        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <span class="section-label">WHO WE ARE</span>

                <h2>Helping People When They Need It Most</h2>

                <p>
                    Gift of the Givers is a humanitarian relief organisation
                    focused on responding to emergencies and supporting
                    communities facing difficult circumstances.
                </p>

                <p>
                    Our work focuses on providing practical assistance such
                    as food, water, medical support and emergency relief.
                    We believe that every person deserves dignity, compassion
                    and the opportunity to rebuild their lives.
                </p>

                <p>
                    Through the support of donors, volunteers and partners,
                    we work to make a meaningful difference in communities
                    locally and internationally.
                </p>

            </div>


            <div class="col-lg-6">

                <div class="about-highlight">

                    <div class="about-icon">❤</div>

                    <h3>Our Mission</h3>

                    <p>
                        To provide effective humanitarian assistance to people
                        affected by disasters and hardship, while restoring
                        hope and dignity.
                    </p>

                </div>

            </div>

        </div>

    </div>
    ```

</section>

<!-- Our Values -->

<section class="values-section">
    <div class="container">

        ```
        <div class="text-center mb-5">

            <span class="section-label">OUR VALUES</span>

            <h2>What Guides Our Work</h2>

        </div>


        <div class="row g-4">

            <div class="col-md-4">

                <div class="value-card">

                    <div class="value-icon">🤝</div>

                    <h4>Compassion</h4>

                    <p>
                        We treat every person we assist with dignity,
                        respect and understanding.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="value-card">

                    <div class="value-icon">🌍</div>

                    <h4>Humanity</h4>

                    <p>
                        We believe that helping people in need is a shared
                        responsibility that crosses borders.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="value-card">

                    <div class="value-icon">💚</div>

                    <h4>Integrity</h4>

                    <p>
                        We aim to use resources responsibly and focus on
                        creating meaningful humanitarian impact.
                    </p>

                </div>

            </div>

        </div>

    </div>
    ```

</section>

<!-- Call To Action -->

<section class="about-cta">

    ```
    <div class="container text-center">

        <h2>Help Us Make A Difference</h2>

        <p>
            Whether you donate, volunteer or simply share our mission,
            your support can help someone in need.
        </p>

        <a asp-controller="Donation"
           asp-action="Index"
           class="btn btn-gotg btn-lg">
            Support Our Work
        </a>

    </div>
    ```

</section>
