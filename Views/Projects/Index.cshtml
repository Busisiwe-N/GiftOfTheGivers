@{
    ViewData["Title"] = "Relief Projects";
}

<!-- Projects Hero -->
<section class="projects-hero">
    <div class="container text-center">

        <span class="section-label">OUR WORK</span>

        <h1>Relief Projects</h1>

        <p>
            Discover the humanitarian projects helping communities
            affected by disaster, poverty and hardship.
        </p>

    </div>
</section>


<!-- Projects -->
<section class="projects-section">

    <div class="container">

        <div class="row g-4">

            <!-- Project 1 -->
            <div class="col-md-6 col-lg-4">

                <div class="project-card">

                    <div class="project-image medical">
                        🏥
                    </div>

                    <div class="project-content">

                        <span class="project-category">
                            HEALTHCARE
                        </span>

                        <h3>Medical Relief</h3>

                        <p>
                            Providing essential medical assistance,
                            healthcare supplies and support to communities
                            affected by emergencies.
                        </p>

                        <div class="project-progress">

                            <div class="d-flex justify-content-between">
                                <span>Project Support</span>
                                <strong>75%</strong>
                            </div>

                            <div class="progress">
                                <div class="progress-bar"
                                     style="width: 75%;">
                                </div>
                            </div>

                        </div>

                        <a href="#"
                           class="btn btn-outline-success">
                            View Project
                        </a>

                    </div>

                </div>

            </div>


            <!-- Project 2 -->
            <div class="col-md-6 col-lg-4">

