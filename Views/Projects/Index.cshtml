<!-- Projects CTA -->
<section class="projects-cta">

    <div class="container text-center">

        <h2>Help Support Our Projects</h2>

        <p>
            Your donation can help us provide essential assistance
            to people and communities in need.
        </p>

        <a asp-controller="Donation"
           asp-action="Index"
           class="btn btn-gotg btn-lg">
            Donate Now
        </a>

    </div>

</section>